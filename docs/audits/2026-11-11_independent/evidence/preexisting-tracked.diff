+        method="rhf",
+        basis="sto-3g",
+        options={"direct": False},
+    )
+    res_stored = backend.single_point(req_stored)
+    assert res_stored.status == "succeeded"
+
+    # Run with direct=True (Direct SCF)
+    req_direct = CalculationRequest(
+        task="single_point",
+        molecule=_H2_MOL,
+        backend="native",
+        method="rhf",
+        basis="sto-3g",
+        options={"direct": True},
+    )
+    res_direct = backend.single_point(req_direct)
