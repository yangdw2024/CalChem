+use calchem_basis::BasisSet;
+use calchem_dft::{GridLevel, XcFunctional};
+use calchem_model::{Atom, Molecule, ScfOptions};
+
+#[test]
+fn ri_wavefunctions_cannot_silently_use_exact_coulomb_gradients() {
+    let mol = Molecule::new(
+        vec![
+            Atom::from_bohr("H", [0.0; 3]).unwrap(),
+            Atom::from_bohr("H", [0.0, 0.0, 1.4]).unwrap(),
+        ],
+        0,
+        1,
+    );
+    let basis = BasisSet::from_name("sto-3g", &mol).unwrap();
+    let opts = ScfOptions {
+        density_fitting: true,
+        ..Default::default()
+    };
+    let wf = calchem_scf::rhf(&mol, &basis, &opts).unwrap();
+    assert!(wf.density_fitting);
+    assert!(calchem_grad::rhf_gradient(&mol, &basis, &wf)
+        .unwrap_err()
+        .to_string()
+        .contains("RI-J analytic gradients"));
+    let wf = calchem_scf::rks(&mol, &basis, XcFunctional::Pbe, GridLevel::Coarse, &opts).unwrap();
+    assert!(
+        calchem_grad::rks_gradient(&mol, &basis, XcFunctional::Pbe, GridLevel::Coarse, &wf)
+            .is_err()
+    );
+    let wf = calchem_scf::uhf(&mol, &basis, &opts).unwrap();
+    assert!(calchem_grad::uhf_gradient(&mol, &basis, &wf).is_err());
+    let wf = calchem_scf::uks(&mol, &basis, XcFunctional::Pbe, GridLevel::Coarse, &opts).unwrap();
+    assert!(
+        calchem_grad::uks_gradient(&mol, &basis, XcFunctional::Pbe, GridLevel::Coarse, &wf)
+            .is_err()
+    );
+}

